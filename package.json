{
  "name": "yt-pipeline",
  "version": "0.2.0",
  "description": "Automated YouTube content pipeline for AI/Tech news",
  "private": true,
  "main": "dist/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/pipeline-core && tsc",
    "build:core": "npm run build --workspace=packages/pipeline-core",
    "build:wc": "npm run build --workspace=packages/wc-pipeline",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "pipeline": "tsx src/pipeline.ts",
    "db:generate": "prisma generate && prisma generate --schema=packages/monitor/prisma/schema.prisma",
    "db:push": "node scripts/prisma-guard.mjs db push",
    "db:migrate": "node scripts/prisma-guard.mjs migrate dev",
    "db:studio": "prisma studio",
    "db:deploy": "node scripts/prisma-guard.mjs migrate deploy",
    "db:validate": "prisma validate --schema=packages/monitor/prisma/schema.prisma && prisma validate --schema=prisma/schema.prisma",
    "db:check-migrations": "node scripts/check-migrations.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:unit": "tsx --test tests/prisma-guard.test.ts tests/check-migrations.test.ts tests/pipeline-logic.test.ts",
    "test:youtube": "node scripts/with-railway-youtube.mjs yt-pipeline -- tsx --test tests/integration.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@prisma/client": "^6.3.0",
    "@yt-pipeline/pipeline-core": "*",
    "dotenv": "^17.3.1",
    "googleapis": "^144.0.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.34.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "prisma": "^6.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
