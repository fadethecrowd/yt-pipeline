generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum TopicStatus {
  DISCOVERED
  APPROVED
  SCRIPTED
  REJECTED
  FAILED
}

enum VideoStatus {
  SCRIPT_PENDING
  SCRIPT_DONE
  QUALITY_FAILED
  VOICEOVER_PENDING
  VOICEOVER_DONE
  ASSEMBLY_PENDING
  ASSEMBLY_DONE
  SEO_PENDING
  SEO_DONE
  UPLOAD_PENDING
  UPLOADED
  PUBLISHED
  FAILED
}

// ── Models ─────────────────────────────────────────────────────────────────

model Topic {
  id        String      @id @default(cuid())
  title     String
  url       String      @unique
  source    String // e.g. "techcrunch", "hackernews", "ars_technica"
  summary   String?
  score     Float? // relevance score 0-1
  status    TopicStatus @default(DISCOVERED)
  videos    Video[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([source])
  @@index([createdAt])
}

model Video {
  id      String      @id @default(cuid())
  topicId String
  topic   Topic       @relation(fields: [topicId], references: [id])
  status  VideoStatus @default(SCRIPT_PENDING)

  // Script stage
  scriptJson   Json? // structured script: hook, segments[], cta
  hookSegment  String? // best hook excerpt + timestamp range for Shorts clipping
  qualityScore Int? // 0-100 from quality gate

  // Voiceover stage
  voiceoverUrls String[] // local paths to MP3 segments
  voiceoverPath String? // path to concatenated final.mp3

  // Assembly stage
  videoPath String? // local path to assembled final.mp4
  videoUrl  String? // remote video URL (after upload)

  // Thumbnail stage
  thumbnailHeadline String? // 2-5 ALL CAPS words generated by thumbnailHeadlineGenerator
  thumbnailSubtext  String? // optional, max 3 words, secondary cue
  thumbnailA        String?
  thumbnailB        String?
  thumbnailC        String?

  // SEO stage
  seoTitle       String?
  titleVariantB  String?
  titleVariantC  String?
  seoDescription String?
  seoTags        String[]
  seoChapters    Json? // [{time: "0:00", label: "Intro"}, ...]

  // Upload stage
  youtubeId   String? // YouTube video ID after upload
  shortsUrl   String? // YouTube Shorts URL after Short upload
  scheduledAt DateTime? // scheduled publish time
  publishedAt DateTime?

  // Tracking
  failReason String?
  retryCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([topicId])
  @@index([createdAt])
}

// ── Topic Library (shared across channels) ────────────────────────────────

enum TopicLibraryStatus {
  PENDING
  USED
  ARCHIVED
}

model TopicLibrary {
  id        String             @id @default(cuid())
  channel   String // "ai-doom" | "wet-circuit"
  title     String
  source    String? // "reddit" | "rss" | "manual" | etc.
  url       String?
  summary   String?
  priority  Int                @default(0)
  status    TopicLibraryStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([channel, status, priority])
  @@map("topic_library")
}

// ── Wet Circuit (wc_) Models ──────────────────────────────────────────────

model WcTopic {
  id        String      @id @default(cuid())
  title     String
  url       String      @unique
  source    String // e.g. "panbo", "passagemaker"
  summary   String?
  score     Float? // relevance score 0-1
  status    TopicStatus @default(DISCOVERED)
  videos    WcVideo[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@map("wc_topic")
}

model WcVideo {
  id      String      @id @default(cuid())
  topicId String
  topic   WcTopic     @relation(fields: [topicId], references: [id])
  status  VideoStatus @default(SCRIPT_PENDING)
  runMode String      @default("LIVE") // "LIVE" or "DRY_RUN"

  // Script stage
  scriptJson   Json?
  hookSegment  String?
  qualityScore Int?

  // Voiceover stage
  voiceoverUrls String[]
  voiceoverPath String?

  // Assembly stage
  videoPath String?
  videoUrl  String?

  // Thumbnail stage
  thumbnailHeadline String? // mirrors Video — kept parallel for shared PipelineContext typing
  thumbnailSubtext  String?
  thumbnailA        String?
  thumbnailB        String?
  thumbnailC        String?

  // SEO stage
  seoTitle       String?
  titleVariantB  String?
  titleVariantC  String?
  seoDescription String?
  seoTags        String[]
  seoChapters    Json?

  // Upload stage
  youtubeId   String?
  shortsUrl   String?
  scheduledAt DateTime?
  publishedAt DateTime?

  // Tracking
  failReason String?
  retryCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([topicId])
  @@index([createdAt])
  @@map("wc_video")
}

// ── Pipeline run summary ────────────────────────────────────────────────
//
// One row written per runPipeline() invocation by yt-pipeline / wc-pipeline.
// Captures health/duration + dry-run-aware output verification. Read by
// the monitor's Telegram /status command.

enum PipelineRunStatus {
  CRITICAL // channel mismatch / token revoked at startup; pipeline aborted
  FAILED // a stage permanently failed (after retries)
  WARNING // all stages completed but output verification flagged something
  SUCCESS // all stages completed and outputs verified
  IDLE // topicDiscovery returned no work and no fallback was available
}

model PipelineRun {
  id                   String            @id @default(cuid())
  channel              String // "ai-doom-scroll" | "wet-circuit"
  runMode              String // "LIVE" | "DRY_RUN"
  status               PipelineRunStatus
  startTime            DateTime
  endTime              DateTime?
  durationMs           Int?
  failedStage          String?
  errorMessage         String?
  warnings             Json              @default("[]")
  videoId              String? // pipeline DB row id (NOT youtubeId)
  youtubeId            String?
  scheduledAt          DateTime?
  shortsUrl            String?
  verifiedChannelTitle String?
  verifiedChannelId    String?
  createdAt            DateTime          @default(now())

  @@index([channel, createdAt])
  @@map("pipeline_run")
}

// ═══════════════════════════════════════════════════════════════════════════
// Reliability / QA / cost-control models
//
// All additive — no existing table or column is modified. Shared by
// yt-pipeline (ai-doom-scroll) and wc-pipeline (wet-circuit); every row
// carries `channel` so the two never mix.
// ═══════════════════════════════════════════════════════════════════════════

/// Which testing stage consumed the resource. Budgets are tracked per stage
/// so diagnostic/qualification spend can be separated from production spend.
enum TestStage {
  DIAGNOSTIC
  QUALIFICATION
  RETEST
  REPEATABILITY
  PRODUCTION
}

/// One row per ElevenLabs API attempt (success or failure).
///
/// `chargedChars` is read from the `character-cost` response header and is
/// the authoritative charge — never assume 1 credit per character.
/// `generationId` is the `history-item-id` header, `requestId` the
/// `request-id` header.
///
/// Idempotency key is (videoId, segmentIndex, scriptHash): if a successful
/// row exists for that triple AND its outputPath is still on disk, the
/// generation is reused instead of re-requested. A failed render, upload,
/// caption or thumbnail step therefore never re-charges for audio that was
/// already produced.
model ElevenLabsUsage {
  id             String    @id @default(cuid())
  channel        String
  testStage      TestStage @default(PRODUCTION)
  runId          String?
  videoId        String
  segmentIndex   Int
  scriptHash     String
  generationId   String?
  requestId      String?
  model          String
  voiceId        String
  outputFormat   String
  requestedChars Int
  chargedChars   Int?
  attempt        Int       @default(1)
  retryReason    String?
  outputPath     String?
  audioDurationS Float?
  success        Boolean
  reused         Boolean   @default(false)
  errorMessage   String?
  createdAt      DateTime  @default(now())

  @@index([channel, createdAt])
  @@index([videoId, segmentIndex])
  @@index([videoId, segmentIndex, scriptHash, success])
  @@index([testStage, channel])
  @@map("elevenlabs_usage")
}

/// Per-scene visual provenance and validation outcome. One row per scene per
/// video, so every frame on screen is traceable to a source and a validation
/// verdict.
model SceneRecord {
  id               String   @id @default(cuid())
  channel          String
  videoId          String
  sceneNumber      Int
  narration        String
  startTimeS       Float
  endTimeS         Float
  prompt           String
  assetSource      String
  assetId          String?
  assetUrl         String?
  localPath        String?
  width            Int?
  height           Int?
  durationS        Float?
  cropMethod       String?
  validation       String
  rejectionReason  String?
  relevanceScore   Float?
  relevanceVerdict String?
  assetDescription String?
  relevanceReasons String[]
  renderStatus     String
  createdAt        DateTime @default(now())

  @@unique([videoId, sceneNumber])
  @@index([channel, createdAt])
  @@index([validation])
  @@map("scene_record")
}

/// Machine-readable QA result for one rendered asset. `checks` holds the full
/// per-check JSON; the scalar columns exist so failures are queryable.
model QaRecord {
  id                String    @id @default(cuid())
  channel           String
  testStage         TestStage
  videoId           String
  assetKind         String
  youtubeId         String?
  runtimeS          Float?
  audioDurationS    Float?
  videoDurationS    Float?
  captionStartS     Float?
  captionEndS       Float?
  captionOffsetHead Float?
  captionOffsetMid  Float?
  captionOffsetTail Float?
  maxCaptionOffset  Float?
  scriptHash        String?
  creditsCharged    Int?
  generationIds     String[]
  privacyStatus     String?
  verifiedChannelId String?
  audioResult       String?
  captionResult     String?
  visualResult      String?
  metadataResult    String?
  uploadResult      String?
  overall           String
  failureNotes      String?
  requiredRepair    String?
  retestOf          String?
  reviewer          String?
  checks            Json      @default("{}")
  createdAt         DateTime  @default(now())

  @@index([channel, createdAt])
  @@index([overall])
  @@index([videoId])
  @@map("qa_record")
}

/// Credit budget per (channel, stage). `reservedChars` is incremented inside a
/// transaction before an ElevenLabs call and reconciled to the real
/// `character-cost` afterwards, so two pipelines running concurrently cannot
/// oversubscribe the same balance.
model CreditBudget {
  id            String    @id @default(cuid())
  channel       String
  testStage     TestStage
  limitChars    Int
  reservedChars Int       @default(0)
  chargedChars  Int       @default(0)
  enabled       Boolean   @default(true)
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  @@unique([channel, testStage])
  @@map("credit_budget")
}

/// Circuit-breaker state. A single row per channel plus a global row
/// (channel = "*"). While `tripped` is true no new generation job may start.
model CircuitBreaker {
  id           String    @id @default(cuid())
  channel      String    @unique
  tripped      Boolean   @default(false)
  trigger      String?
  detail       String?
  affectedJobs String[]
  trippedAt    DateTime?
  clearedAt    DateTime?
  clearedBy    String?
  updatedAt    DateTime  @updatedAt

  @@map("circuit_breaker")
}

/// Append-only log of circuit-breaker trips and clears, for post-mortem.
model CircuitBreakerEvent {
  id        String   @id @default(cuid())
  channel   String
  event     String
  trigger   String
  detail    String?
  videoId   String?
  createdAt DateTime @default(now())

  @@index([channel, createdAt])
  @@map("circuit_breaker_event")
}

// ── Operational safety: quarantine + script failure classification ────────

/// Explicit, reversible quarantine for jobs that must never be auto-resumed.
///
/// The pipeline's resume logic selects videos by status, so a stale row in a
/// resumable status is picked up on the next restart. Quarantining records the
/// original status here and moves the row to a non-resumable status; restoring
/// is a matter of writing `originalStatus` back and setting `releasedAt`.
model JobQuarantine {
  id             String    @id @default(cuid())
  channel        String
  videoId        String
  table          String
  originalStatus String
  newStatus      String
  reason         String
  operator       String
  actionSource   String
  releasedAt     DateTime?
  releasedBy     String?
  createdAt      DateTime  @default(now())

  @@unique([videoId, releasedAt])
  @@index([channel, createdAt])
  @@map("job_quarantine")
}

/// How a script-generation attempt failed.
///
/// A model declining to write a script is a legitimate, correct outcome — most
/// often because topic discovery surfaced something out of scope. It must be
/// recorded as a refusal, never parsed as a script and never retried verbatim.
enum ScriptFailureType {
  VALID
  MODEL_REFUSAL
  OFF_TOPIC
  THIN_SOURCE
  TRUNCATED_JSON
  MALFORMED_JSON
  EMPTY_RESPONSE
  SCHEMA_INVALID
  API_ERROR
}

model ScriptGenerationFailure {
  id          String            @id @default(cuid())
  channel     String
  videoId     String?
  topicId     String?
  topicTitle  String?
  pillar      String?
  failureType ScriptFailureType
  detail      String
  promptHash  String
  attempt     Int               @default(1)
  createdAt   DateTime          @default(now())

  @@index([channel, createdAt])
  @@index([failureType])
  @@map("script_generation_failure")
}

// ── Durable upload intent ─────────────────────────────────────────────────

/// Lifecycle of a single intended YouTube upload.
///
/// The states exist so that a process death at ANY point leaves evidence that
/// distinguishes "never called YouTube" from "YouTube may already have it".
enum UploadIntentState {
  /// Row written before anything is sent. Guards have passed.
  PREPARED
  /// Written immediately before videos.insert. If a crash leaves an intent
  /// here, the remote outcome is UNKNOWN and must be reconciled, never retried.
  UPLOAD_STARTED
  /// videos.insert returned an id. The id is durable from this point.
  REMOTE_CONFIRMED
  /// The owning video row now carries the youtubeId. Terminal success.
  PERSISTED
  /// Remote state could not be resolved automatically. Terminal until a human
  /// acts; blocks all further upload attempts for the asset.
  RECONCILIATION_REQUIRED
  /// Failed before any remote call. Safe to retry — YouTube never saw it.
  FAILED_BEFORE_REMOTE_CALL
}

/// One row per intended upload of one approved artifact.
///
/// Exists because `youtubeId == null` is not evidence that nothing was
/// uploaded: qualification asset ai1 was accepted by YouTube as uVQ-vcJHWNk
/// and the process died before the id was written, leaving a remote orphan
/// that every local check reported as "never uploaded". The intent is written
/// BEFORE the remote call, so that failure mode now leaves an unresolved row.
///
/// `correlationId` is echoed into the uploaded video's tags, which makes the
/// remote object self-identifying and therefore reconcilable without any
/// local record of its id.
model UploadIntent {
  id            String @id @default(cuid())
  /// Embedded in the remote video's tags as `qid-<correlationId>`.
  correlationId String @unique

  channel     String
  channelId   String
  testStage   TestStage
  format      String
  assetKey    String
  videoId     String
  /// "video" (AI Doom) or "wc_video" (Wet Circuit).
  sourceTable String    @default("video")

  // Immutable identity of the approved artifact.
  fileSha256          String
  manifestSha256      String
  metadataFingerprint String

  // Immutable expectations, asserted again at reconciliation time.
  expectedTitle      String
  expectedPrivacy    String  @default("private")
  publishAtAbsent    Boolean @default(true)
  expectedDurationS  Float?
  durationToleranceS Float   @default(2)

  state             UploadIntentState @default(PREPARED)
  youtubeId         String?           @unique
  remoteEtag        String?
  remotePublishedAt DateTime?
  adopted           Boolean           @default(false)

  attempts      Int       @default(0)
  lastError     String?
  reconcileNote String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// One intent per (asset, approved artifact) — a retry reuses the row
  /// rather than opening a second upload path.
  @@unique([videoId, fileSha256, manifestSha256])
  @@index([state])
  @@index([channel, createdAt])
  @@index([videoId])
  @@map("upload_intent")
}
