# ── Database (Neon Postgres) ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/yt_pipeline?sslmode=require"

# ── Anthropic (Claude API) ───────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── ElevenLabs (TTS) ────────────────────────────────────────────────────
ELEVENLABS_API_KEY="xi-..."
ELEVENLABS_VOICE_ID="voice_id_here"

# ── Pexels (stock video) ──────────────────────────────────────────────
PEXELS_API_KEY="your-pexels-api-key-here"

# ── YouTube Data API v3 (OAuth2) ────────────────────────────────────────
YOUTUBE_CLIENT_ID="xxx.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="GOCSPX-..."

# Credential source. Exactly one of these is required.
#
# YOUTUBE_TOKEN_FILE — local path to the file written by get-youtube-token.ts.
# When set it is AUTHORITATIVE and YOUTUBE_REFRESH_TOKEN is ignored. Prefer it
# locally: the token file and the env var used to drift silently, and a stale
# env var authenticating as the wrong (or a revoked) identity is not something
# the pipeline could previously detect. The file must be mode 600.
# YOUTUBE_TOKEN_FILE="token-ai-doom-scroll.json"
#
# YOUTUBE_REFRESH_TOKEN — the deployed path. Railway sets this and does NOT set
# YOUTUBE_TOKEN_FILE, so deployed behaviour is unchanged.
YOUTUBE_REFRESH_TOKEN="1//..."

# Local safety switch: blocks ElevenLabs spend and real uploads.
DISABLE_ELEVEN=true

# ── Monitor Cost Controls ─────────────────────────────────────────────
MONITOR_AI_ENABLED="true"           # Set to "true" to enable Claude calls; default false (safe off)
MONITOR_AI_DAILY_CALL_LIMIT=20      # Max Claude API calls per UTC day across all monitor callers
POLL_INTERVAL_MS=3600000            # Poll interval in ms; minimum 900000 (15 min), default 3600000 (1 hr)

# ── Pipeline Config ────────────────────────────────────────────────────
NODE_ENV="development"
PIPELINE_LOCK_ID=123456
QUALITY_THRESHOLD=75
