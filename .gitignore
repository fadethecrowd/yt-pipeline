.DS_Store

# Local-only YouTube OAuth token files — never commit.
#
# Patterns, not exact names: the loopback helper writes timestamped backups
# (token-*.json.bak-<iso>) and a short-lived verification token
# (.token-*.verify.json) before promoting a credential. Naming files
# individually left those untracked-but-ignorable, so a single `git add -A`
# would have staged a live refresh token.
token.json
token-*.json
token-*.json.bak-*
.token-*.verify.json
*.token.json
client_secret*.json
oauth-callback-*.json

# Render artifacts and scratch (large, regenerable, machine-specific)
tmp/
audio/
output/
video/

# Benchmark working media and contact sheets: large, regenerable from the
# manifest (real Pexels IDs + deterministic sampling). Hashes are tracked.
tmp/bench2/
tmp/qual-review/
tmp/qual-review-v2/
tmp/qual-dc/
tmp/qual-dc-v2/
tmp/catalog/
tmp/qual-dc-v3/
tmp/qual-dc-v4/
tmp/qual-dc-v5/
