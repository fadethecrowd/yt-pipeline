generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Pipeline enums (must match root schema exactly) ─────────────────────

enum TopicStatus {
  DISCOVERED
  APPROVED
  SCRIPTED
  REJECTED
  FAILED
}

enum VideoStatus {
  SCRIPT_PENDING
  SCRIPT_DONE
  QUALITY_FAILED
  VOICEOVER_PENDING
  VOICEOVER_DONE
  ASSEMBLY_PENDING
  ASSEMBLY_DONE
  SEO_PENDING
  SEO_DONE
  UPLOAD_PENDING
  UPLOADED
  PUBLISHED
  FAILED
}

// ── Pipeline models (shared DB, read-only from monitor) ─────────────────

model Topic {
  id        String      @id @default(cuid())
  title     String
  url       String      @unique
  source    String
  summary   String?
  score     Float?
  status    TopicStatus @default(DISCOVERED)
  videos    Video[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([source])
  @@index([createdAt])
}

model Video {
  id      String      @id @default(cuid())
  topicId String
  topic   Topic       @relation(fields: [topicId], references: [id])
  status  VideoStatus @default(SCRIPT_PENDING)

  scriptJson   Json?
  hookSegment  String? // best hook excerpt + timestamp range for Shorts clipping
  qualityScore Int?

  voiceoverUrls String[]
  voiceoverPath String?

  videoPath String?
  videoUrl  String?

  thumbnailHeadline String?
  thumbnailSubtext  String?
  thumbnailA        String?
  thumbnailB        String?
  thumbnailC        String?

  seoTitle       String?
  titleVariantB  String?
  titleVariantC  String?
  seoDescription String?
  seoTags        String[]
  seoChapters    Json?

  youtubeId   String?
  shortsUrl   String?
  scheduledAt DateTime?
  publishedAt DateTime?

  failReason String?
  retryCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // VideoSnapshot relation removed — monitor tables are now channel-scoped
  // and reference videoId as a plain string (see packages/monitor/src/lib/channelDb.ts).

  @@index([status])
  @@index([topicId])
  @@index([createdAt])
}

// ── Topic Library (shared across channels) ────────────────────────────────

enum TopicLibraryStatus {
  PENDING
  USED
  ARCHIVED
}

model TopicLibrary {
  id        String             @id @default(cuid())
  channel   String
  title     String
  source    String?
  url       String?
  summary   String?
  priority  Int                @default(0)
  status    TopicLibraryStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([channel, status, priority])
  @@map("topic_library")
}

// ── Wet Circuit models (shared DB, not used by monitor but must be present) ──

model WcTopic {
  id        String      @id @default(cuid())
  title     String
  url       String      @unique
  source    String
  summary   String?
  score     Float?
  status    TopicStatus @default(DISCOVERED)
  videos    WcVideo[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@map("wc_topic")
}

// WcVideo mirrors Video field-for-field so the shared PipelineContext.video
// type accepts both. thumbnailHeadline/Subtext are AI-Doom-only at runtime
// (wc-pipeline never sets them) but must exist on WcVideo for type parity.
model WcVideo {
  id                String      @id @default(cuid())
  topicId           String
  topic             WcTopic     @relation(fields: [topicId], references: [id])
  status            VideoStatus @default(SCRIPT_PENDING)
  runMode           String      @default("LIVE")
  scriptJson        Json?
  hookSegment       String?
  qualityScore      Int?
  voiceoverUrls     String[]
  voiceoverPath     String?
  videoPath         String?
  videoUrl          String?
  thumbnailHeadline String?
  thumbnailSubtext  String?
  thumbnailA        String?
  thumbnailB        String?
  thumbnailC        String?
  seoTitle          String?
  titleVariantB     String?
  titleVariantC     String?
  seoDescription    String?
  seoTags           String[]
  seoChapters       Json?
  youtubeId         String?
  shortsUrl         String?
  scheduledAt       DateTime?
  publishedAt       DateTime?
  failReason        String?
  retryCount        Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
  @@index([topicId])
  @@index([createdAt])
  @@map("wc_video")
}

// ── Monitor enums ───────────────────────────────────────────────────────

enum ActionType {
  PIN_COMMENT
  HEART_COMMENT
  REPLY_COMMENT
  UPDATE_TITLE
  UPDATE_DESCRIPTION
  UPDATE_TAGS
  REGENERATE_THUMBNAIL
  COMMUNITY_POST
  END_SCREEN
  REPROMOTE
  REDDIT_POST
  GENERATE_SHORT
  ALERT
}

enum ActionStatus {
  PENDING
  AWAITING_APPROVAL
  EXECUTED
  FAILED
  SKIPPED
}

// ── Monitor models (channel-scoped) ─────────────────────────────────────
//
// All monitor-owned tables carry a `channel` column so a single Postgres
// instance can host state for multiple channel deploys (CHANNEL env var).
// FKs from these tables to Video are intentionally dropped so a row's
// videoId can reference either `Video` (ai-doom-scroll) or `wc_video`
// (wet-circuit). App-level integrity is enforced in channelDb.ts.

model VideoSnapshot {
  id                      String   @id @default(cuid())
  channel                 String
  videoId                 String
  views                   Int
  likes                   Int
  comments                Int
  ctr                     Float?
  impressions             Int?
  avgViewDuration         Float?
  avgViewPercentage       Float?
  estimatedMinutesWatched Float?
  isShort                 Boolean  @default(false)
  createdAt               DateTime @default(now())

  @@index([channel, videoId, createdAt])
}

model Comment {
  id               String   @id @default(cuid())
  channel          String
  videoId          String
  youtubeCommentId String
  authorName       String
  authorChannel    String?
  text             String
  likeCount        Int      @default(0)
  isHearted        Boolean  @default(false)
  isPinned         Boolean  @default(false)
  publishedAt      DateTime
  scrapedAt        DateTime @default(now())

  @@unique([channel, youtubeCommentId])
  @@index([channel, videoId, publishedAt])
}

model MonitorAction {
  id         String       @id @default(cuid())
  channel    String
  videoId    String
  type       ActionType
  status     ActionStatus @default(PENDING)
  payload    Json
  reason     String
  result     String?
  createdAt  DateTime     @default(now())
  executedAt DateTime?

  @@index([channel, videoId])
  @@index([channel, status])
  @@index([channel, videoId, type, status])
}

model DigestLog {
  id         String   @id @default(cuid())
  channel    String
  period     String
  videoCount Int
  summary    String
  sentVia    String
  createdAt  DateTime @default(now())

  @@unique([channel, period, createdAt])
  @@index([channel, period, createdAt])
}

model ChannelGoal {
  id                  String   @id @default(cuid())
  channel             String   @unique
  goal                String
  autonomyTier        Int      @default(2)
  bootstrapBenchmarks Json     @default("{\"avgCtr\":4.5,\"avgViewDuration\":40,\"avgViews48hr\":500,\"avgSubsPerVideo\":10}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model TopicSeed {
  id        String    @id @default(cuid())
  channel   String
  title     String
  rationale String
  source    String // e.g. "reddit:r/artificial"
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([channel, createdAt])
}

model RedditPost {
  id           String    @id @default(cuid())
  channel      String
  videoId      String
  subreddit    String // e.g. "r/artificial"
  title        String
  body         String
  redditPostId String? // Reddit's thing ID after posting
  redditUrl    String? // full URL to the posted thread
  status       String    @default("DRAFT") // DRAFT, APPROVED, POSTED, FAILED
  createdAt    DateTime  @default(now())
  postedAt     DateTime?

  @@unique([channel, videoId, subreddit])
  @@index([channel, videoId])
  @@index([channel, status])
}

// ── Pipeline run summary (mirrors root schema — must match exactly) ─────
//
// Read-only from monitor's perspective; pipelines are the writers.

enum PipelineRunStatus {
  CRITICAL
  FAILED
  WARNING
  SUCCESS
  IDLE
}

model PipelineRun {
  id                   String            @id @default(cuid())
  channel              String
  runMode              String
  status               PipelineRunStatus
  startTime            DateTime
  endTime              DateTime?
  durationMs           Int?
  failedStage          String?
  errorMessage         String?
  warnings             Json              @default("[]")
  videoId              String?
  youtubeId            String?
  scheduledAt          DateTime?
  shortsUrl            String?
  verifiedChannelTitle String?
  verifiedChannelId    String?
  createdAt            DateTime          @default(now())

  @@index([channel, createdAt])
  @@map("pipeline_run")
}

// ═══════════════════════════════════════════════════════════════════════════
// Reliability / QA / cost-control models
//
// All additive — no existing table or column is modified. Shared by
// yt-pipeline (ai-doom-scroll) and wc-pipeline (wet-circuit); every row
// carries `channel` so the two never mix.
// ═══════════════════════════════════════════════════════════════════════════

/// Which testing stage consumed the resource. Budgets are tracked per stage
/// so diagnostic/qualification spend can be separated from production spend.
enum TestStage {
  DIAGNOSTIC
  QUALIFICATION
  RETEST
  REPEATABILITY
  PRODUCTION
}

/// One row per ElevenLabs API attempt (success or failure).
///
/// `chargedChars` is read from the `character-cost` response header and is
/// the authoritative charge — never assume 1 credit per character.
/// `generationId` is the `history-item-id` header, `requestId` the
/// `request-id` header.
///
/// Idempotency key is (videoId, segmentIndex, scriptHash): if a successful
/// row exists for that triple AND its outputPath is still on disk, the
/// generation is reused instead of re-requested. A failed render, upload,
/// caption or thumbnail step therefore never re-charges for audio that was
/// already produced.
model ElevenLabsUsage {
  id             String    @id @default(cuid())
  channel        String
  testStage      TestStage @default(PRODUCTION)
  runId          String?
  videoId        String
  segmentIndex   Int
  scriptHash     String
  generationId   String?
  requestId      String?
  model          String
  voiceId        String
  outputFormat   String
  requestedChars Int
  chargedChars   Int?
  attempt        Int       @default(1)
  retryReason    String?
  outputPath     String?
  audioDurationS Float?
  success        Boolean
  reused         Boolean   @default(false)
  errorMessage   String?
  createdAt      DateTime  @default(now())

  @@index([channel, createdAt])
  @@index([videoId, segmentIndex])
  @@index([videoId, segmentIndex, scriptHash, success])
  @@index([testStage, channel])
  @@map("elevenlabs_usage")
}

/// Per-scene visual provenance and validation outcome. One row per scene per
/// video, so every frame on screen is traceable to a source and a validation
/// verdict.
model SceneRecord {
  id               String   @id @default(cuid())
  channel          String
  videoId          String
  sceneNumber      Int
  narration        String
  startTimeS       Float
  endTimeS         Float
  prompt           String
  assetSource      String
  assetId          String?
  assetUrl         String?
  localPath        String?
  width            Int?
  height           Int?
  durationS        Float?
  cropMethod       String?
  validation       String
  rejectionReason  String?
  relevanceScore   Float?
  relevanceVerdict String?
  assetDescription String?
  relevanceReasons String[]
  renderStatus     String
  createdAt        DateTime @default(now())

  @@unique([videoId, sceneNumber])
  @@index([channel, createdAt])
  @@index([validation])
  @@map("scene_record")
}

/// Machine-readable QA result for one rendered asset. `checks` holds the full
/// per-check JSON; the scalar columns exist so failures are queryable.
model QaRecord {
  id                String    @id @default(cuid())
  channel           String
  testStage         TestStage
  videoId           String
  assetKind         String
  youtubeId         String?
  runtimeS          Float?
  audioDurationS    Float?
  videoDurationS    Float?
  captionStartS     Float?
  captionEndS       Float?
  captionOffsetHead Float?
  captionOffsetMid  Float?
  captionOffsetTail Float?
  maxCaptionOffset  Float?
  scriptHash        String?
  creditsCharged    Int?
  generationIds     String[]
  privacyStatus     String?
  verifiedChannelId String?
  audioResult       String?
  captionResult     String?
  visualResult      String?
  metadataResult    String?
  uploadResult      String?
  overall           String
  failureNotes      String?
  requiredRepair    String?
  retestOf          String?
  reviewer          String?
  checks            Json      @default("{}")
  createdAt         DateTime  @default(now())

  @@index([channel, createdAt])
  @@index([overall])
  @@index([videoId])
  @@map("qa_record")
}

/// Credit budget per (channel, stage). `reservedChars` is incremented inside a
/// transaction before an ElevenLabs call and reconciled to the real
/// `character-cost` afterwards, so two pipelines running concurrently cannot
/// oversubscribe the same balance.
model CreditBudget {
  id            String    @id @default(cuid())
  channel       String
  testStage     TestStage
  limitChars    Int
  reservedChars Int       @default(0)
  chargedChars  Int       @default(0)
  enabled       Boolean   @default(true)
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  @@unique([channel, testStage])
  @@map("credit_budget")
}

/// Circuit-breaker state. A single row per channel plus a global row
/// (channel = "*"). While `tripped` is true no new generation job may start.
model CircuitBreaker {
  id           String    @id @default(cuid())
  channel      String    @unique
  tripped      Boolean   @default(false)
  trigger      String?
  detail       String?
  affectedJobs String[]
  trippedAt    DateTime?
  clearedAt    DateTime?
  clearedBy    String?
  updatedAt    DateTime  @updatedAt

  @@map("circuit_breaker")
}

/// Append-only log of circuit-breaker trips and clears, for post-mortem.
model CircuitBreakerEvent {
  id        String   @id @default(cuid())
  channel   String
  event     String
  trigger   String
  detail    String?
  videoId   String?
  createdAt DateTime @default(now())

  @@index([channel, createdAt])
  @@map("circuit_breaker_event")
}

// ── Operational safety: quarantine + script failure classification ────────

/// Explicit, reversible quarantine for jobs that must never be auto-resumed.
///
/// The pipeline's resume logic selects videos by status, so a stale row in a
/// resumable status is picked up on the next restart. Quarantining records the
/// original status here and moves the row to a non-resumable status; restoring
/// is a matter of writing `originalStatus` back and setting `releasedAt`.
model JobQuarantine {
  id             String    @id @default(cuid())
  channel        String
  videoId        String
  table          String
  originalStatus String
  newStatus      String
  reason         String
  operator       String
  actionSource   String
  releasedAt     DateTime?
  releasedBy     String?
  createdAt      DateTime  @default(now())

  @@unique([videoId, releasedAt])
  @@index([channel, createdAt])
  @@map("job_quarantine")
}

/// How a script-generation attempt failed.
///
/// A model declining to write a script is a legitimate, correct outcome — most
/// often because topic discovery surfaced something out of scope. It must be
/// recorded as a refusal, never parsed as a script and never retried verbatim.
enum ScriptFailureType {
  VALID
  MODEL_REFUSAL
  OFF_TOPIC
  THIN_SOURCE
  TRUNCATED_JSON
  MALFORMED_JSON
  EMPTY_RESPONSE
  SCHEMA_INVALID
  API_ERROR
}

model ScriptGenerationFailure {
  id          String            @id @default(cuid())
  channel     String
  videoId     String?
  topicId     String?
  topicTitle  String?
  pillar      String?
  failureType ScriptFailureType
  detail      String
  promptHash  String
  attempt     Int               @default(1)
  createdAt   DateTime          @default(now())

  @@index([channel, createdAt])
  @@index([failureType])
  @@map("script_generation_failure")
}

// ── Durable upload intent ─────────────────────────────────────────────────

/// Lifecycle of a single intended YouTube upload.
///
/// The states exist so that a process death at ANY point leaves evidence that
/// distinguishes "never called YouTube" from "YouTube may already have it".
enum UploadIntentState {
  /// Row written before anything is sent. Guards have passed.
  PREPARED
  /// Written immediately before videos.insert. If a crash leaves an intent
  /// here, the remote outcome is UNKNOWN and must be reconciled, never retried.
  UPLOAD_STARTED
  /// videos.insert returned an id. The id is durable from this point.
  REMOTE_CONFIRMED
  /// The owning video row now carries the youtubeId. Terminal success.
  PERSISTED
  /// Remote state could not be resolved automatically. Terminal until a human
  /// acts; blocks all further upload attempts for the asset.
  RECONCILIATION_REQUIRED
  /// Failed before any remote call. Safe to retry — YouTube never saw it.
  FAILED_BEFORE_REMOTE_CALL
  /// A pre-existing remote video adopted retrospectively. Terminal and
  /// upload-blocking like PERSISTED, but deliberately distinct: it predates the
  /// correlation marker, so its artifact binding is inferred rather than
  /// cryptographically verified. Never produced by a live upload.
  RECONCILED_HISTORICAL_UPLOAD
}

/// One row per intended upload of one approved artifact.
///
/// Exists because `youtubeId == null` is not evidence that nothing was
/// uploaded: qualification asset ai1 was accepted by YouTube as uVQ-vcJHWNk
/// and the process died before the id was written, leaving a remote orphan
/// that every local check reported as "never uploaded". The intent is written
/// BEFORE the remote call, so that failure mode now leaves an unresolved row.
///
/// `correlationId` is echoed into the uploaded video's tags, which makes the
/// remote object self-identifying and therefore reconcilable without any
/// local record of its id.
model UploadIntent {
  id            String @id @default(cuid())
  /// Embedded in the remote video's tags as `qid-<correlationId>`.
  correlationId String @unique

  channel     String
  channelId   String
  testStage   TestStage
  format      String
  assetKey    String
  videoId     String
  /// "video" (AI Doom) or "wc_video" (Wet Circuit).
  sourceTable String    @default("video")

  // Immutable identity of the approved artifact.
  //
  // Nullable ONLY so a retrospectively adopted historical upload can decline to
  // claim hashes it cannot prove. A database CHECK constraint requires both to
  // be present for every state except RECONCILED_HISTORICAL_UPLOAD, so the
  // exact-hash requirement for real uploads is unchanged.
  fileSha256          String?
  manifestSha256      String?
  metadataFingerprint String

  // Evidence provenance. Defaults describe a normal marker-backed upload; the
  // historical reconciliation path sets them explicitly.
  /// "MARKER_BACKED" for live uploads, "HISTORICAL_RECONCILIATION" otherwise.
  provenance             String  @default("MARKER_BACKED")
  /// Whether the correlation marker genuinely exists in the remote video tags.
  remoteMarkerPresent    Boolean @default(true)
  /// Whether the uploaded bytes were cryptographically bound at upload time.
  fileHashVerified       Boolean @default(true)
  /// Whether the scene manifest was cryptographically bound at upload time.
  manifestHashVerified   Boolean @default(true)
  /// Best-supported candidate hashes, explicitly NOT proof of what was sent.
  inferredFileSha256     String?
  inferredManifestSha256 String?
  /// What the evidence does and does not establish.
  evidenceNote           String?

  // Immutable expectations, asserted again at reconciliation time.
  expectedTitle      String
  expectedPrivacy    String  @default("private")
  publishAtAbsent    Boolean @default(true)
  expectedDurationS  Float?
  durationToleranceS Float   @default(2)

  state             UploadIntentState @default(PREPARED)
  youtubeId         String?           @unique
  remoteEtag        String?
  remotePublishedAt DateTime?
  adopted           Boolean           @default(false)

  attempts      Int       @default(0)
  lastError     String?
  reconcileNote String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// One intent per (asset, approved artifact) — a retry reuses the row
  /// rather than opening a second upload path.
  @@unique([videoId, fileSha256, manifestSha256])
  @@index([state])
  @@index([channel, createdAt])
  @@index([videoId])
  @@map("upload_intent")
}

/// A bounded, private-only production pilot.
///
/// The three-video limit must survive a crash, a redeploy and two processes
/// racing, so it lives here rather than in memory: `successCount` is claimed
/// by a conditional UPDATE that only succeeds while the count is below
/// `maxSuccesses`, exactly as credit reservation works. A slot is claimed
/// before the upload and released if the upload does not complete, so an
/// abandoned attempt never consumes one of the three.
///
/// Rollback: this table is additive and referenced only by pilot-mode code
/// paths. Dropping it disables pilot mode and leaves every other behaviour
/// untouched; no existing column or row is modified by its introduction.
model ProductionPilot {
  id            String       @id @default(cuid())
  /// Stable human-facing identifier, e.g. "ai-doom-private-pilot-1".
  pilotId       String       @unique
  channel       String
  channelId     String
  status        PilotStatus  @default(PREPARED)
  maxSuccesses  Int          @default(3)
  /// Slots claimed. Never decremented below the number of confirmed uploads.
  successCount  Int          @default(0)
  /// Video ids that reached terminal UPLOADED under this pilot.
  successVideoIds String[]   @default([])
  /// Only candidates created after this instant may count toward the pilot.
  activatedAt   DateTime?
  completedAt   DateTime?
  privacyStatus String       @default("private")
  allowPublishAt Boolean     @default(false)
  shortsEnabled Boolean      @default(false)
  requireFeasibility Boolean @default(true)
  requireGuardedUpload Boolean @default(true)
  /// Execution window, in `timezone`. NOT a YouTube publish schedule.
  windowDays    Int[]        @default([1, 3, 5])
  windowStartHour Int        @default(17)
  windowEndHour Int          @default(20)
  timezone      String       @default("America/New_York")
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("production_pilot")
}

enum PilotStatus {
  PREPARED
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

enum ProductionCycleStatus {
  AUTHORIZED
  CLAIMED
  COMPLETED
  FAILED
  RECONCILIATION_REQUIRED
}

/// Durable authorization for exactly ONE ordinary production cycle.
///
/// Neither channel has a recurring trigger, so ordinary production happens only
/// when a container starts — and any start (deploy, restart, env change, infra
/// event) would otherwise reach discovery and create a video. Nothing in the
/// existing schema could express "this channel may produce exactly one video for
/// this publication slot": PipelineRun is telemetry with no unique key,
/// ProductionPilot is a lifetime qualification cap, UploadIntent is downstream of
/// candidate creation, and JobQuarantine is a block-list.
///
/// Identity is the intended PUBLICATION slot, never container start time, so a
/// restart at any hour resolves to the same cycle. The unique constraint is what
/// makes a duplicate scheduler event a no-op rather than a second video.
model ProductionCycle {
  id                String                @id @default(cuid())
  channel           String // "ai-doom-scroll" | "wet-circuit"
  /// UTC instant of the Eastern wall-clock publication slot (M/W/F 15:00 ET).
  targetPublishSlot DateTime
  status            ProductionCycleStatus  @default(AUTHORIZED)

  /// Set by the single winning claimant. Identifies which process holds it.
  claimantId        String?
  /// The one candidate this cycle is permitted to produce. Channel-specific:
  /// AI Doom rows live in Video, Wet Circuit rows in WcVideo, so this is a
  /// plain id validated in application code rather than a polymorphic FK that
  /// no single relation could express correctly.
  videoId           String?
  pipelineRunId     String?
  failureCode       String?

  authorizedAt      DateTime              @default(now())
  claimedAt         DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  /// One cycle per channel per publication slot. This is the whole guarantee.
  @@unique([channel, targetPublishSlot])
  @@index([channel, status])
  @@map("production_cycle")
}

/// Durable proof that a supervised run is still supervised.
///
/// `ai-doom-pilot-control --run` removes the auth_check lock and relies on its
/// own `finally` to put it back. That survives exceptions but not the process
/// being killed — on 2026-08-13 it was, Railway stayed production-capable, and
/// the container bought 5,683 characters of narration unattended.
///
/// So authority lives here instead of in a process. The controller opens a row
/// before unlocking, renews `heartbeatAt` while it watches, and closes it when
/// the run ends. Every expensive action re-checks this row. A killed controller
/// stops renewing, the lease goes stale, and spend/upload/start all refuse —
/// without anything having to notice the controller died.
///
/// The monitors hold no RAILWAY_TOKEN and cannot relock the environment from
/// outside, so the Railway variables cannot be the safety boundary. This row is.
model SupervisedLease {
  id              String    @id @default(cuid())
  channel         String // "ai-doom-scroll" | "wet-circuit"
  pilotId         String
  /// Identifies the single controller invocation that owns this lease. Only it
  /// may renew; renewal moves the heartbeat and never extends expiresAt.
  controllerToken String
  /// Bound once known, so a lease cannot be reused for another candidate.
  videoId         String?
  runId           String?
  status          String    @default("ACTIVE") // ACTIVE | CLOSED | EXPIRED

  openedAt        DateTime  @default(now())
  /// Last controller renewal. Absence of renewal is how death is detected.
  heartbeatAt     DateTime  @default(now())
  /// Hard ceiling on authority, whatever the renewals say.
  expiresAt       DateTime
  closedAt        DateTime?
  closedReason    String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([channel, status])
  @@index([status, expiresAt])
  @@map("supervised_lease")
}

enum ProductionTrancheStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  CLOSED
}

enum TrancheSlotStatus {
  CLAIMED
  SETTLED_SUCCESS
  SETTLED_FAILED
  RECONCILIATION_REQUIRED
  /// Consumed, then given back: the candidate failed deterministically before
  /// any irreversible action. The row stays as the audit trail.
  RELEASED
}

/// Finite, expiring authorization for ordinary production spend.
///
/// Graduation proves a channel MAY produce; it grants no money. This does:
/// a human authorizes exactly N candidate attempts, each of which may open one
/// candidate-scoped narration window, and when N is consumed or the clock runs
/// out the channel is financially inert again. There is deliberately no
/// "production is enabled" flag anywhere — spend needs a row that says how much.
model ProductionTranche {
  id                  String                  @id @default(cuid())
  channel             String
  /// Candidate ATTEMPTS authorized, not successes. A failure still consumes one.
  maxCandidates       Int
  /// Monotonic. Never decremented, so slotIndex stays unique.
  consumedCandidates  Int                     @default(0)
  /// Attempts given back after a deterministic pre-spend failure. Effective
  /// consumption is consumedCandidates - releasedCandidates.
  releasedCandidates  Int                     @default(0)
  status              ProductionTrancheStatus @default(ACTIVE)

  /// First-tranche policy: Shorts are a second, unqualified upload path, so a
  /// tranche states explicitly whether it authorizes them.
  shortsEnabled       Boolean                 @default(false)

  /// Free-text record of who authorized it and why.
  authorizedBy        String
  /// The commit the authorization was granted against.
  policyCommit        String?

  authorizedAt        DateTime                @default(now())
  expiresAt           DateTime
  closedAt            DateTime?
  closedReason        String?

  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  slots               ProductionTrancheSlot[]

  @@index([channel, status])
  @@index([status, expiresAt])
  @@map("production_tranche")
}

/// One consumed candidate attempt, bound to the exact execution that took it.
///
/// The slot is created at the moment candidate and run identity both exist, so
/// there is never an unclaimed-but-in-use slot that a second candidate could
/// adopt — the same lesson the supervised lease learned the hard way.
model ProductionTrancheSlot {
  id            String            @id @default(cuid())
  trancheId     String
  channel       String
  /// Position within the tranche. Unique per tranche, so capacity cannot be
  /// exceeded even if two claimers somehow reached the insert together.
  slotIndex     Int
  status        TrancheSlotStatus @default(CLAIMED)

  videoId       String
  runId         String

  claimedAt     DateTime          @default(now())
  settledAt     DateTime?
  outcome       String?

  /// Audit of a release. Written once, never cleared.
  releasedAt          DateTime?
  releaseReason       String?
  releaseClassification String?

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tranche       ProductionTranche @relation(fields: [trancheId], references: [id])

  @@unique([trancheId, slotIndex])
  @@unique([videoId])
  @@index([channel, status])
  @@map("production_tranche_slot")
}
