generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Pipeline enums (must match root schema exactly) ─────────────────────

enum TopicStatus {
  DISCOVERED
  APPROVED
  SCRIPTED
  REJECTED
  FAILED
}

enum VideoStatus {
  SCRIPT_PENDING
  SCRIPT_DONE
  QUALITY_FAILED
  VOICEOVER_PENDING
  VOICEOVER_DONE
  ASSEMBLY_PENDING
  ASSEMBLY_DONE
  SEO_PENDING
  SEO_DONE
  UPLOAD_PENDING
  UPLOADED
  PUBLISHED
  FAILED
}

// ── Pipeline models (shared DB, read-only from monitor) ─────────────────

model Topic {
  id        String      @id @default(cuid())
  title     String
  url       String      @unique
  source    String
  summary   String?
  score     Float?
  status    TopicStatus @default(DISCOVERED)
  videos    Video[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([source])
  @@index([createdAt])
}

model Video {
  id             String      @id @default(cuid())
  topicId        String
  topic          Topic       @relation(fields: [topicId], references: [id])
  status         VideoStatus @default(SCRIPT_PENDING)

  scriptJson     Json?
  hookSegment    String?     // best hook excerpt + timestamp range for Shorts clipping
  qualityScore   Int?

  voiceoverUrls  String[]
  voiceoverPath  String?

  videoPath      String?
  videoUrl       String?

  thumbnailHeadline String?
  thumbnailSubtext  String?
  thumbnailA     String?
  thumbnailB     String?
  thumbnailC     String?

  seoTitle       String?
  titleVariantB  String?
  titleVariantC  String?
  seoDescription String?
  seoTags        String[]
  seoChapters    Json?

  youtubeId      String?
  shortsUrl      String?
  scheduledAt    DateTime?
  publishedAt    DateTime?

  failReason     String?
  retryCount     Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // VideoSnapshot relation removed — monitor tables are now channel-scoped
  // and reference videoId as a plain string (see packages/monitor/src/lib/channelDb.ts).

  @@index([status])
  @@index([topicId])
  @@index([createdAt])
}

// ── Topic Library (shared across channels) ────────────────────────────────

enum TopicLibraryStatus {
  PENDING
  USED
  ARCHIVED
}

model TopicLibrary {
  id        String             @id @default(cuid())
  channel   String
  title     String
  source    String?
  url       String?
  summary   String?
  priority  Int                @default(0)
  status    TopicLibraryStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("topic_library")
  @@index([channel, status, priority])
}

// ── Wet Circuit models (shared DB, not used by monitor but must be present) ──

model WcTopic {
  id        String      @id @default(cuid())
  title     String
  url       String      @unique
  source    String
  summary   String?
  score     Float?
  status    TopicStatus @default(DISCOVERED)
  videos    WcVideo[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("wc_topic")
  @@index([status])
  @@index([source])
  @@index([createdAt])
}

// WcVideo mirrors Video field-for-field so the shared PipelineContext.video
// type accepts both. thumbnailHeadline/Subtext are AI-Doom-only at runtime
// (wc-pipeline never sets them) but must exist on WcVideo for type parity.
model WcVideo {
  id             String      @id @default(cuid())
  topicId        String
  topic          WcTopic     @relation(fields: [topicId], references: [id])
  status         VideoStatus @default(SCRIPT_PENDING)
  runMode        String      @default("LIVE")
  scriptJson     Json?
  hookSegment    String?
  qualityScore   Int?
  voiceoverUrls  String[]
  voiceoverPath  String?
  videoPath      String?
  videoUrl       String?
  thumbnailHeadline String?
  thumbnailSubtext  String?
  thumbnailA     String?
  thumbnailB     String?
  thumbnailC     String?
  seoTitle       String?
  titleVariantB  String?
  titleVariantC  String?
  seoDescription String?
  seoTags        String[]
  seoChapters    Json?
  youtubeId      String?
  shortsUrl      String?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  failReason     String?
  retryCount     Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("wc_video")
  @@index([status])
  @@index([topicId])
  @@index([createdAt])
}

// ── Monitor enums ───────────────────────────────────────────────────────

enum ActionType {
  PIN_COMMENT
  HEART_COMMENT
  REPLY_COMMENT
  UPDATE_TITLE
  UPDATE_DESCRIPTION
  UPDATE_TAGS
  REGENERATE_THUMBNAIL
  COMMUNITY_POST
  END_SCREEN
  REPROMOTE
  REDDIT_POST
  GENERATE_SHORT
  ALERT
}

enum ActionStatus {
  PENDING
  AWAITING_APPROVAL
  EXECUTED
  FAILED
  SKIPPED
}

// ── Monitor models (channel-scoped) ─────────────────────────────────────
//
// All monitor-owned tables carry a `channel` column so a single Postgres
// instance can host state for multiple channel deploys (CHANNEL env var).
// FKs from these tables to Video are intentionally dropped so a row's
// videoId can reference either `Video` (ai-doom-scroll) or `wc_video`
// (wet-circuit). App-level integrity is enforced in channelDb.ts.

model VideoSnapshot {
  id                      String   @id @default(cuid())
  channel                 String
  videoId                 String
  views                   Int
  likes                   Int
  comments                Int
  ctr                     Float?
  impressions             Int?
  avgViewDuration         Float?
  avgViewPercentage       Float?
  estimatedMinutesWatched Float?
  createdAt               DateTime @default(now())

  @@index([channel, videoId, createdAt])
}

model Comment {
  id               String   @id @default(cuid())
  channel          String
  videoId          String
  youtubeCommentId String
  authorName       String
  authorChannel    String?
  text             String
  likeCount        Int      @default(0)
  isHearted        Boolean  @default(false)
  isPinned         Boolean  @default(false)
  publishedAt      DateTime
  scrapedAt        DateTime @default(now())

  @@unique([channel, youtubeCommentId])
  @@index([channel, videoId, publishedAt])
}

model MonitorAction {
  id         String       @id @default(cuid())
  channel    String
  videoId    String
  type       ActionType
  status     ActionStatus @default(PENDING)
  payload    Json
  reason     String
  result     String?
  createdAt  DateTime     @default(now())
  executedAt DateTime?

  @@index([channel, videoId])
  @@index([channel, status])
  @@index([channel, videoId, type, status])
}

model DigestLog {
  id         String   @id @default(cuid())
  channel    String
  period     String
  videoCount Int
  summary    String
  sentVia    String
  createdAt  DateTime @default(now())

  @@unique([channel, period, createdAt])
  @@index([channel, period, createdAt])
}

model ChannelGoal {
  id                  String   @id @default(cuid())
  channel             String   @unique
  goal                String
  autonomyTier        Int      @default(2)
  bootstrapBenchmarks Json     @default("{\"avgCtr\":4.5,\"avgViewDuration\":40,\"avgViews48hr\":500,\"avgSubsPerVideo\":10}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model TopicSeed {
  id        String   @id @default(cuid())
  channel   String
  title     String
  rationale String
  source    String   // e.g. "reddit:r/artificial"
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([channel, createdAt])
}

model RedditPost {
  id           String    @id @default(cuid())
  channel      String
  videoId      String
  subreddit    String    // e.g. "r/artificial"
  title        String
  body         String
  redditPostId String?   // Reddit's thing ID after posting
  redditUrl    String?   // full URL to the posted thread
  status       String    @default("DRAFT") // DRAFT, APPROVED, POSTED, FAILED
  createdAt    DateTime  @default(now())
  postedAt     DateTime?

  @@unique([channel, videoId, subreddit])
  @@index([channel, videoId])
  @@index([channel, status])
}

// ── Pipeline run summary (mirrors root schema — must match exactly) ─────
//
// Read-only from monitor's perspective; pipelines are the writers.

enum PipelineRunStatus {
  CRITICAL
  FAILED
  WARNING
  SUCCESS
  IDLE
}

model PipelineRun {
  id                    String            @id @default(cuid())
  channel               String
  runMode               String
  status                PipelineRunStatus
  startTime             DateTime
  endTime               DateTime?
  durationMs            Int?
  failedStage           String?
  errorMessage          String?
  warnings              Json              @default("[]")
  videoId               String?
  youtubeId             String?
  scheduledAt           DateTime?
  shortsUrl             String?
  verifiedChannelTitle  String?
  verifiedChannelId     String?
  createdAt             DateTime          @default(now())

  @@map("pipeline_run")
  @@index([channel, createdAt])
}
